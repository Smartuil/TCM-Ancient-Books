{
  "name": "tcm-ancient-books",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "data": "python3 scripts/build_data.py --src . --out public/data",
    "data:local": "python3 scripts/build_data.py --src ../books --out public/data",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node tests/progress.test.mjs && node tests/fts.test.mjs",
    "data:index": "python3 scripts/build_index.py --shards 512",
    "data:all": "npm run data && npm run data:index",
    "test:dom": "node tests/dom-progress.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
